# Copie este arquivo para .env.local e preencha os valores.
# O .env.local NUNCA vai para o Git (está no .gitignore).

# ── Supabase ────────────────────────────────────────────────
# Project Settings → Data API → Project URL
NEXT_PUBLIC_SUPABASE_URL=
# Project Settings → API Keys → Publishable key (começa com sb_publishable_)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Project Settings → API Keys → Secret key (começa com sb_secret_) — só no servidor
SUPABASE_SECRET_KEY=
# Botão "Connect" → Transaction pooler (porta 6543), com a senha do banco no lugar de [YOUR-PASSWORD]
DATABASE_URL=

# ── Google Places API (New) ─────────────────────────────────
# Google Cloud → APIs e serviços → Credenciais → Chave de API
GOOGLE_PLACES_API_KEY=
# Limite mensal de requisições que o Garimpo aceita gastar (cota grátis = 1000)
GOOGLE_PLACES_MONTHLY_REQUEST_LIMIT=1000
